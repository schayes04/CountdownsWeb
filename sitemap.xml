---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
	<url>
		<loc>{{ '/policies' | absolute_url }}</loc>
	</url>
	{% assign sitemap_pages = site.guide_pages | sort: "nav_order" %}
	{% for locale in site.data.locales %}
		{% assign locale_prefix = "" %}
		{% if locale.folder and locale.folder != "" %}
			{% assign locale_prefix = "/" | append: locale.folder %}
		{% endif %}
		<url>
			<loc>{{ locale_prefix | append: "/" | absolute_url }}</loc>
		</url>
		<url>
			<loc>{{ locale_prefix | append: "/countdown-ideas/" | absolute_url }}</loc>
		</url>
		{% capture support_path %}{% include locale-url.html locale=locale key="support" %}{% endcapture %}
		<url>
			<loc>{{ support_path | absolute_url }}</loc>
		</url>
        {% assign tool_routes = 'when-is,anniversary-calculator,days-until-calculator' | split: ',' %}
        {% for tool_route in tool_routes %}<url><loc>{{ tool_route | prepend: '/' | prepend: locale_prefix | append: '/' | absolute_url }}</loc></url>{% endfor %}
        {% for holiday in site.data.holidays %}<url><loc>{{ holiday.slug | prepend: '/when-is/' | prepend: locale_prefix | append: '/' | absolute_url }}</loc></url>{% endfor %}
		{% for sitemap_page in sitemap_pages %}
			<url>
				<loc>{{ locale_prefix | append: sitemap_page.url | absolute_url }}</loc>
			</url>
		{% endfor %}
	{% endfor %}
</urlset>
