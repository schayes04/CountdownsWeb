+    struct Event: Codable {
+        let id: String
+        let name: String
+        let emoji: String
+        let date: String
+        // CountdownUnit has Int raw values: "0" = years, ... "6" = seconds.
+        let units: [String]
+        let listId: String?
+        let colorIndex: Int?
+        let allowsCountUp: Bool
+        let repeatYearly: Bool
+        let showOccurrenceNumber: Bool
