 import WidgetKit
 
+#if DEBUG && targetEnvironment(simulator)
+// Only the opt-in website fixture seeder writes this app-group preference.
+// These are selection inputs; countdown values still come from ExtensionDataManager.
+struct WebsiteScreenshotWidgetFixture: Decodable, Equatable {
+    struct Event: Decodable, Equatable {
+        let id: String
+        let name: String
+    }
+
+    let scene: String
+    let locale: String
+    let showDirection: Bool
+    let events: [Event]
+
+    static func load() -> Self? {
+        guard let data = UserDefaults(suiteName: Constants.appGroup)?
+            .data(forKey: "websiteScreenshotWidgetFixture"),
+              let fixture = try? JSONDecoder().decode(Self.self, from: data),
+              !fixture.scene.isEmpty, !fixture.locale.isEmpty, !fixture.events.isEmpty,
+              fixture.events.allSatisfy({ !$0.id.isEmpty && !$0.name.isEmpty }),
+              Set(fixture.events.map(\.id)).count == fixture.events.count else {
+            return nil
+        }
+        return fixture
+    }
+
+    func recordTimelineEvidence(family: WidgetFamily, countdowns: [UnmanagedCountdown], configuration: [String: Any]) {
+        let familyName: String
+        switch family {
+        case .systemSmall: familyName = "systemSmall"
+        case .systemMedium: familyName = "systemMedium"
+        case .systemLarge: familyName = "systemLarge"
+        case .accessoryRectangular: familyName = "accessoryRectangular"
+        case .accessoryCircular: familyName = "accessoryCircular"
+        case .accessoryInline: familyName = "accessoryInline"
+        default: return
+        }
+        guard let container = FileManager.default.containerURL(forSecurityApplicationGroupIdentifier: Constants.appGroup) else {
+            debugPrint("Website widget timeline evidence: app-group container unavailable")
+            return
+        }
+        let formatter = ISO8601DateFormatter()
+        formatter.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        let events: [[String: Any]] = countdowns.map { countdown in
+            // Do not use .id: it manufactures a UUID if the stored identifier is missing.
+            ["id": countdown.uniqueIdentifier.map { $0 as Any } ?? NSNull(), "name": countdown.name]
+        }
+        let payload: [String: Any] = [
+            "evidenceKind": "timeline-data",
+            "scene": scene, "locale": locale,
+            "generatedAt": formatter.string(from: Date()), "family": familyName,
+            "events": events, "effectiveConfiguration": configuration,
+            "preferredLocalizations": Bundle.main.preferredLocalizations,
+            "currentLocaleIdentifier": Locale.current.identifier
+        ]
+        do {
+            let data = try JSONSerialization.data(withJSONObject: payload, options: [.prettyPrinted, .sortedKeys])
+            // A fixture switch during generation must not relabel this older timeline.
+            guard Self.load() == self else { return }
+            let url = container.appendingPathComponent("website-widget-timeline-\(familyName).json")
+            try data.write(to: url, options: .atomic)
+        } catch {
+            debugPrint("Website widget timeline evidence failed:", error)
+        }
+    }
+}
+#endif
