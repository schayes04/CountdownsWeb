+        func localDate(calendar: Calendar) throws -> Date {
+            // Fixtures use Gregorian civil dates regardless of the app's locale calendar.
+            var fixtureCalendar = Calendar(identifier: .gregorian)
+            fixtureCalendar.timeZone = calendar.timeZone
+            guard date.utf8.count == 10,
+                  date.range(of: "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", options: .regularExpression) != nil else {
+                throw FixtureError.invalid("Invalid yyyy-MM-dd date for \(id)")
+            }
+            let parts = date.split(separator: "-").compactMap { Int($0) }
+            let components = DateComponents(year: parts[0], month: parts[1], day: parts[2])
+            guard parts[0] > 0,
+                  let value = fixtureCalendar.date(from: components),
+                  fixtureCalendar.component(.year, from: value) == parts[0],
+                  fixtureCalendar.component(.month, from: value) == parts[1],
+                  fixtureCalendar.component(.day, from: value) == parts[2] else {
+                throw FixtureError.invalid("Invalid local calendar date for \(id)")
+            }
+            return fixtureCalendar.startOfDay(for: value)
+        }
