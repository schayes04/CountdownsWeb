+            tabs.showSettingsTab()
+        }
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.5) { [weak self, weak window] in
+            guard let self, let window else { return }
+            self.finishWebsiteScreenshot(in: window, attemptsRemaining: 40)
