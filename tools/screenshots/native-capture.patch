+    private func finishWebsiteScreenshot(in window: UIWindow, attemptsRemaining: Int) {
+        guard let fixture = Self.preparedWebsiteFixture,
+              let tabs = window.rootViewController as? TabBarViewController else { return }
+        // UIKit can attach the sheet to a parent or the countdowns controller.
+        var visible: UIViewController = tabs
+        while true {
+            if let presented = visible.presentedViewController {
+                visible = presented
+            } else if let tabController = visible as? UITabBarController, let selected = tabController.selectedViewController {
+                visible = selected
+            } else if let navigation = visible as? UINavigationController, let top = navigation.visibleViewController {
+                visible = top
+            } else {
+                break
+            }
+        }
+        let correctScreen: Bool
+        switch fixture.screen {
+        case .list: correctScreen = visible is CountdownsViewController
+        case .settings: correctScreen = visible is SettingsViewController
+        case .editor: correctScreen = visible is AddCountdownTableViewController
+        }
+        guard correctScreen, visible.viewIfLoaded?.window === window,
+              visible.transitionCoordinator == nil, visible.navigationController?.transitionCoordinator == nil else {
+            guard attemptsRemaining > 0 else {
+                print("Website screenshot fixture failed: requested screen did not become ready")
+                return
+            }
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.25) { [weak self, weak window] in
+                guard let self, let window else { return }
+                self.finishWebsiteScreenshot(in: window, attemptsRemaining: attemptsRemaining - 1)
+            }
+            return
+        }
+        window.endEditing(true)
+        window.layoutIfNeeded()
+        // Scroll only controller-owned content, never internal date-picker wheels.
+        func resetScrollPosition(_ controller: UIViewController) {
+            if let scrollView = controller.view as? UIScrollView {
+                scrollView.scrollToTop(animated: false)
+            } else if let scrollView = controller.view.subviews.first(where: { $0 is UIScrollView }) as? UIScrollView {
+                scrollView.scrollToTop(animated: false)
+            }
+            controller.children.forEach { resetScrollPosition($0) }
+        }
+        resetScrollPosition(visible)
+        window.layoutIfNeeded()
+        do {
+            try writeWebsiteScreenshotProof(fixture)
+        } catch {
+            print("Website screenshot proof failed: \(error)")
+        }
+    }
